# MySQL (MYSQL_USER must not be root: the mysql image rejects it)
MYSQL_DATABASE=nexgate_management
MYSQL_USER=nexgate
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

# Redis
REDIS_PORT=6379

# MongoDB
MONGO_DATABASE=nexgate_analytics
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me
MONGO_PORT=27017

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Gateway
NEXGATE_REDIS_URL=redis://redis:6379
NEXGATE_IDEMPOTENCY_TTL_SECONDS=86400
NEXGATE_MANAGEMENT_BASE_URL=http://api-management:8081

# JWT shared by api-management, smart-gateway and analytics (HS256, >= 32 bytes)
NEXGATE_JWT_SECRET=replace-with-at-least-32-character-secret
NEXGATE_JWT_ISSUER=gatekeeper-api-management

# Credentials the gateway uses to log in to api-management (seeded user: gateway-service)
NEXGATE_GATEWAY_USERNAME=gateway-service
NEXGATE_GATEWAY_PASSWORD=change-me
