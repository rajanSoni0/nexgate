# NexGate Console — development proxy targets.
# These are NOT read by the browser at request time: the Vite dev/preview server
# proxies /proxy/<service>/** to these URLs, because the backend has no CORS
# configuration. Do not put credentials or tokens in this file.
VITE_MANAGEMENT_API_URL=http://localhost:8081
VITE_GATEWAY_API_URL=http://localhost:8080
VITE_ANALYTICS_API_URL=http://localhost:8084
VITE_CATALOG_API_URL=http://localhost:8082
VITE_ORDER_API_URL=http://localhost:8083
